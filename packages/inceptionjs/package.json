{
  "name": "inceptionjs",
  "version": "0.1.0",
  "description": "A web browser engine (WebKit compiled to WebAssembly) that runs inside a web page and draws into a canvas. GPU-first, with a JSON-RPC protocol and an opt-in, policy-guarded API for AI agents.",
  "keywords": [
    "browser",
    "webkit",
    "webassembly",
    "embed",
    "iframe",
    "agent",
    "ai-agent",
    "browser-automation",
    "canvas",
    "webgl"
  ],
  "license": "Apache-2.0",
  "author": "The InceptionJS Authors",
  "homepage": "https://inceptionjs.com",
  "bugs": {
    "url": "https://github.com/yojona/InceptionJS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yojona/InceptionJS.git",
    "directory": "packages/inceptionjs"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./types/server.d.ts",
      "default": "./dist/server/index.js"
    },
    "./vite": {
      "types": "./types/vite.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./next": {
      "types": "./types/next.d.ts",
      "default": "./dist/next/index.js"
    },
    "./types/*": "./types/*.d.ts"
  },
  "bin": {
    "inceptionjs": "bin/inceptionjs.js"
  },
  "files": [
    "dist",
    "types",
    "bin",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs",
    "prepack": "node ../legal.mjs && node build.mjs"
  },
  "dependencies": {
    "binaryen": "132.0.0",
    "ws": "8.22.0"
  },
  "engines": {
    "node": ">=20"
  }
}
