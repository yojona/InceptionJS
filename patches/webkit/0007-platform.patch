+
+#include "config.h"
+#include "UserAgent.h"
+
+#include <wtf/NeverDestroyed.h>
+#include <wtf/text/MakeString.h>
+
+namespace WebCore {
+
+// A Linux WebKit browser's user agent. Sites decide which media pipeline and
+// which code to serve from it; this one gets the same pages other WebKit
+// browsers on Linux get, which is what the engine actually is. The "605.1.15"
+// and "Version/" tokens are frozen values sites expect from WebKit.
+static const String& baseUserAgent()
+{
+    static NeverDestroyed<String> userAgent("Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/605.1.15 (KHTML, like Gecko) Version/18.0 Safari/605.1.15"_s);
+    return userAgent;
+}
+
+String standardUserAgent(const String& applicationName, const String& applicationVersion)
+{
+    if (applicationName.isEmpty())
+        return baseUserAgent();
+    return makeString(baseUserAgent(), ' ', applicationName, '/', applicationVersion.isEmpty() ? "1.0"_s : applicationVersion);
+}
+
+String standardUserAgentForURL(const URL&)
+{
+    return baseUserAgent();
+}
+
+} // namespace WebCore
