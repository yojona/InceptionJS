+#pragma once
+
+#if ENABLE(WEB_AUDIO)
+
+#include "AudioBus.h"
+#include "AudioDestination.h"
+#include <atomic>
+#include <wtf/Lock.h>
+#include <wtf/Threading.h>
+
+// Provided by the embedder: the window of the page whose script is running
+// (an audio context is made by script), or 0.
+extern "C" int inception_audio_owner();
+
+namespace WebCore {
+
+// Audio output through the host page. A thread of the engine renders render
+// quanta into a ring of planar float samples in the engine's own memory, which
+// is shared with the host; an AudioWorklet in the host page reads the ring and
+// plays it. The ring's indexes are atomics both sides wait and wake on.
+class AudioDestinationEmscripten final : public AudioDestination, public ThreadSafeRefCounted<AudioDestinationEmscripten, WTF::DestructionThread::Main> {
+public:
+    explicit AudioDestinationEmscripten(const CreationOptions&);
+    ~AudioDestinationEmscripten();
+
+    void ref() const final { ThreadSafeRefCounted::ref(); }
+    void deref() const final { ThreadSafeRefCounted::deref(); }
+
+    void start(Function<void(Function<void()>&&)>&& dispatchToRenderThread, CompletionHandler<void(bool)>&&) final;
+    void stop(CompletionHandler<void(bool)>&&) final;
+    bool isPlaying() final { return m_isPlaying; }
+    unsigned framesPerBuffer() const final;
+    MediaTime outputLatency() const final;
+
+    // Frames the ring holds: about 43 ms at 48 kHz, the most the host's output
+    // can lag behind rendering.
+    static constexpr int32_t capacity = 2048;
+
+private:
+    void renderLoop();
+    void renderQuantum(int32_t written);
+    void notifyIsPlaying();
+
+    // [0] frames written, [1] frames read, [2] quanta the host found missing.
+    alignas(16) std::atomic<int32_t> m_header[4] { };
+    std::unique_ptr<float[]> m_samples;
+    Ref<AudioBus> m_renderBus;
+    std::atomic<bool> m_running { false };
+    bool m_isPlaying { false };
+    uint64_t m_framesRendered { 0 };
+    int m_id;
+    int m_window { 0 };
+
+    Lock m_dispatchLock;
+    Function<void(Function<void()>&&)> m_dispatchToRenderThread WTF_GUARDED_BY_LOCK(m_dispatchLock);
+};
+
+} // namespace WebCore
+
+#endif // ENABLE(WEB_AUDIO)
