+#include "config.h"
+#include "AudioDestinationEmscripten.h"
+
+#if ENABLE(WEB_AUDIO)
+
+#include "AudioUtilities.h"
+#include <emscripten/em_js.h>
+#include <emscripten/threading.h>
+#include <wtf/MainThread.h>
+#include <wtf/MonotonicTime.h>
+#include <memory>
+#include <wtf/threads/BinarySemaphore.h>
+
+// The host (host/audio.js) plays a ring from this point on; the event goes out
+// through the engine thread's bridge, which is where start and stop run.
+// `window` is the engine window whose page made the context (0: unknown), so
+// the host plays it where that window is shown.
+EM_JS(void, inception_audio_open, (int id, int header, int samples, int capacity, int channels, float sampleRate, int window), {
+    postMessage({ inception: JSON.stringify({ event: 'audio.open', data: { id, header, samples, capacity, channels, sampleRate, ...(window > 0 ? { window } : {}) } }) });
+});
+
+EM_JS(void, inception_audio_close, (int id), {
+    postMessage({ inception: JSON.stringify({ event: 'audio.close', data: { id } }) });
+});
+
+namespace WebCore {
+
+static constexpr size_t quantumFrames = AudioUtilities::renderQuantumSize;
+static_assert(!(AudioDestinationEmscripten::capacity % quantumFrames), "quanta must not straddle the ring's end");
+
+Ref<AudioDestination> AudioDestination::create(const CreationOptions& options)
+{
+    return adoptRef(*new AudioDestinationEmscripten(options));
+}
+
+// The host page creates its output at whatever rate a destination asks for and
+// resamples to the device, so this only picks the default for new contexts.
+float AudioDestination::hardwareSampleRate()
+{
+    return 48000;
+}
+
+unsigned long AudioDestination::maxChannelCount()
+{
+    return 0;
+}
+
+AudioDestinationEmscripten::AudioDestinationEmscripten(const CreationOptions& options)
+    : AudioDestination(options)
+    , m_samples(std::make_unique<float[]>(static_cast<size_t>(capacity) * options.numberOfOutputChannels))
+    , m_renderBus(AudioBus::create(options.numberOfOutputChannels, quantumFrames))
+{
+    static std::atomic<int> nextID;
+    m_id = ++nextID;
+    m_window = inception_audio_owner();
+}
+
+AudioDestinationEmscripten::~AudioDestinationEmscripten()
+{
+    m_running = false;
+}
+
+unsigned AudioDestinationEmscripten::framesPerBuffer() const
+{
+    return quantumFrames;
+}
+
+MediaTime AudioDestinationEmscripten::outputLatency() const
+{
+    return MediaTime::createWithDouble(static_cast<double>(capacity) / sampleRate());
+}
+
+void AudioDestinationEmscripten::start(Function<void(Function<void()>&&)>&& dispatchToRenderThread, CompletionHandler<void(bool)>&& completionHandler)
+{
+    {
+        Locker locker { m_dispatchLock };
+        m_dispatchToRenderThread = WTF::move(dispatchToRenderThread);
+    }
+    if (!m_isPlaying) {
+        m_header[0] = 0;
+        m_header[1] = 0;
+        m_running = true;
+        inception_audio_open(m_id, reinterpret_cast<int>(&m_header[0]), reinterpret_cast<int>(m_samples.get()), capacity, numberOfOutputChannels(), sampleRate(), m_window);
+        // The thread keeps the destination alive until it sees the stop.
+        Thread::create("WebAudio output"_s, [protectedThis = Ref { *this }] {
+            protectedThis->renderLoop();
+        }, ThreadType::Audio)->detach();
+        m_isPlaying = true;
+        notifyIsPlaying();
+    }
+    callOnMainThread([completionHandler = WTF::move(completionHandler)] mutable {
+        completionHandler(true);
+    });
+}
+
+void AudioDestinationEmscripten::stop(CompletionHandler<void(bool)>&& completionHandler)
+{
+    if (m_isPlaying) {
+        m_running = false;
+        emscripten_futex_wake(&m_header[1], 1);
+        inception_audio_close(m_id);
+        m_isPlaying = false;
+        notifyIsPlaying();
+    }
+    callOnMainThread([completionHandler = WTF::move(completionHandler)] mutable {
+        completionHandler(true);
+    });
+}
+
+void AudioDestinationEmscripten::notifyIsPlaying()
+{
+    Locker locker { m_callbackLock };
+    if (m_callback)
+        m_callback->isPlayingDidChange();
+}
+
+void AudioDestinationEmscripten::renderLoop()
+{
+    while (m_running) {
+        int32_t written = m_header[0].load();
+        int32_t read = m_header[1].load();
+        // Full: wait for the host to read. The timeout only bounds how late a
+        // stop is noticed.
+        if (static_cast<int32_t>(written - read) > static_cast<int32_t>(capacity - quantumFrames)) {
+            emscripten_futex_wait(&m_header[1], static_cast<uint32_t>(read), 100);
+            continue;
+        }
+        renderQuantum(written);
+        m_header[0].store(written + static_cast<int32_t>(quantumFrames));
+    }
+}
+
+void AudioDestinationEmscripten::renderQuantum(int32_t written)
+{
+    AudioIOPosition position { Seconds { m_framesRendered / static_cast<double>(sampleRate()) }, MonotonicTime::now() };
+    bool dispatched = false;
+    // Shared: if the worklet's thread is gone the wait gives up, and the task
+    // must not then signal a semaphore that no longer exists.
+    auto rendered = std::make_shared<BinarySemaphore>();
+    {
+        Locker locker { m_dispatchLock };
+        // With an AudioWorklet, rendering happens on the worklet's thread.
+        if (m_dispatchToRenderThread) {
+            dispatched = true;
+            m_dispatchToRenderThread([protectedThis = Ref { *this }, position, rendered] {
+                protectedThis->callRenderCallback(protectedThis->m_renderBus.get(), quantumFrames, position);
+                rendered->signal();
+            });
+        }
+    }
+    if (!dispatched)
+        callRenderCallback(m_renderBus.get(), quantumFrames, position);
+    else if (!rendered->waitFor(1_s))
+        m_renderBus->zero();
+
+    size_t offset = static_cast<uint32_t>(written) & (capacity - 1);
+    for (unsigned channel = 0; channel < numberOfOutputChannels(); ++channel) {
+        auto source = m_renderBus->channel(channel)->span();
+        std::copy(source.begin(), source.end(), m_samples.get() + channel * static_cast<size_t>(capacity) + offset);
+    }
+    m_framesRendered += quantumFrames;
+}
+
+} // namespace WebCore
+
+#endif // ENABLE(WEB_AUDIO)
