+// FFTFrame for the Emscripten port: an iterative radix-2 transform. Same layout
+// as the other ports without Accelerate: fftSize / 2 + 1 bins from DC to
+// Nyquist, unscaled forward, and an inverse scaled by 1 / fftSize so a round
+// trip returns the input.
+
+#include "config.h"
+
+#if ENABLE(WEB_AUDIO) && PLATFORM(EMSCRIPTEN)
+
+#include "FFTFrame.h"
+
+#include <complex>
+#include <numbers>
+#include <wtf/StdLibExtras.h>
+
+namespace WebCore {
+
+static constexpr int minFFTPow2Size = 2;
+static constexpr int maxFFTPow2Size = 24;
+
+static size_t binCount(unsigned fftSize)
+{
+    return fftSize / 2 + 1;
+}
+
+// In place, size a power of two; `inverse` flips the twiddle sign.
+static void transform(std::span<std::complex<float>> values, bool inverse)
+{
+    size_t size = values.size();
+    for (size_t i = 1, j = 0; i < size; ++i) {
+        size_t bit = size >> 1;
+        for (; j & bit; bit >>= 1)
+            j ^= bit;
+        j ^= bit;
+        if (i < j)
+            std::swap(values[i], values[j]);
+    }
+    for (size_t length = 2; length <= size; length <<= 1) {
+        double angle = 2 * std::numbers::pi / length * (inverse ? 1 : -1);
+        std::complex<double> step(std::cos(angle), std::sin(angle));
+        for (size_t start = 0; start < size; start += length) {
+            std::complex<double> twiddle(1);
+            for (size_t k = 0; k < length / 2; ++k) {
+                auto even = values[start + k];
+                auto odd = values[start + k + length / 2] * std::complex<float>(twiddle);
+                values[start + k] = even + odd;
+                values[start + k + length / 2] = even - odd;
+                twiddle *= step;
+            }
+        }
+    }
+}
+
+FFTFrame::FFTFrame(unsigned fftSize)
+    : m_FFTSize(fftSize)
+    , m_log2FFTSize(static_cast<unsigned>(log2(fftSize)))
+    , m_realData(binCount(fftSize))
+    , m_imagData(binCount(fftSize))
+{
+}
+
+FFTFrame::FFTFrame()
+    : m_FFTSize(0)
+    , m_log2FFTSize(0)
+{
+}
+
+FFTFrame::FFTFrame(const FFTFrame& frame)
+    : m_FFTSize(frame.m_FFTSize)
+    , m_log2FFTSize(frame.m_log2FFTSize)
+    , m_realData(binCount(frame.m_FFTSize))
+    , m_imagData(binCount(frame.m_FFTSize))
+{
+    memcpySpan(m_realData.span(), frame.realData().span());
+    memcpySpan(m_imagData.span(), frame.imagData().span());
+}
+
+void FFTFrame::initialize()
+{
+}
+
+FFTFrame::~FFTFrame() = default;
+
+void FFTFrame::doFFT(std::span<const float> data)
+{
+    Vector<std::complex<float>> values(m_FFTSize, [&](size_t i) {
+        return std::complex<float>(i < data.size() ? data[i] : 0);
+    });
+    transform(values.mutableSpan(), false);
+    auto real = m_realData.span();
+    auto imag = m_imagData.span();
+    for (size_t i = 0; i < binCount(m_FFTSize); ++i) {
+        real[i] = values[i].real();
+        imag[i] = values[i].imag();
+    }
+}
+
+void FFTFrame::doInverseFFT(std::span<float> data)
+{
+    auto real = m_realData.span();
+    auto imag = m_imagData.span();
+    Vector<std::complex<float>> values(m_FFTSize);
+    size_t bins = binCount(m_FFTSize);
+    for (size_t i = 0; i < bins; ++i)
+        values[i] = { real[i], imag[i] };
+    // A real signal's spectrum is conjugate-symmetric.
+    for (size_t i = bins; i < m_FFTSize; ++i)
+        values[i] = std::conj(values[m_FFTSize - i]);
+    transform(values.mutableSpan(), true);
+    float scale = 1.0f / m_FFTSize;
+    for (size_t i = 0; i < m_FFTSize && i < data.size(); ++i)
+        data[i] = values[i].real() * scale;
+}
+
+int FFTFrame::minFFTSize()
+{
+    return 1 << minFFTPow2Size;
+}
+
+int FFTFrame::maxFFTSize()
+{
+    return 1 << maxFFTPow2Size;
+}
