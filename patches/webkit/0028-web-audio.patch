+#include "config.h"
+#include "AudioFileReader.h"
+
+#if ENABLE(WEB_AUDIO)
+
+#include "AudioBus.h"
+#include <atomic>
+#include <bit>
+#include <emscripten/em_js.h>
+#include <emscripten/threading.h>
+#include <wtf/FileSystem.h>
+#include <wtf/MainThread.h>
+#include <wtf/MonotonicTime.h>
+#include <wtf/StdLibExtras.h>
+#include <wtf/text/MakeString.h>
+
+namespace {
+
+// What the host writes back for a decode (host/audio.js): `done` turns 1 with
+// planar float samples it allocated in engine memory, or -1 on failure.
+struct HostDecodeReply {
+    std::atomic<int32_t> done { 0 };
+    int32_t channels { 0 };
+    int32_t frames { 0 };
+    float sampleRate { 0 };
+    float* samples { nullptr };
+};
+
+} // namespace
+
+// Runs on the engine thread, whose bridge the host listens to; the decoding
+// thread waits on the reply.
+EM_JS(void, inception_audio_decode, (const uint8_t* bytes, int length, float sampleRate, void* reply), {
+    postMessage({ inceptionAudioDecode: { bytes, length, sampleRate, reply } });
+});
+
+namespace WebCore {
+
+static uint32_t readLittleEndian(std::span<const uint8_t> data, size_t offset, size_t size)
+{
+    uint32_t value = 0;
+    for (size_t i = 0; i < size; ++i)
+        value |= static_cast<uint32_t>(data[offset + i]) << (8 * i);
+    return value;
+}
+
+// Uncompressed WAVE files (WebKit's own HRTF impulse responses, and pages'
+// PCM) decode here; anything else goes to the host browser's decoder.
+static RefPtr<AudioBus> decodeWave(std::span<const uint8_t> data)
+{
+    if (data.size() < 12 || memcmp(data.data(), "RIFF", 4) || memcmp(data.data() + 8, "WAVE", 4))
+        return nullptr;
+    unsigned format = 0, channels = 0, bitsPerSample = 0;
+    float sampleRate = 0;
+    std::span<const uint8_t> samples;
+    for (size_t offset = 12; offset + 8 <= data.size();) {
+        size_t size = readLittleEndian(data, offset + 4, 4);
+        size_t body = offset + 8;
+        if (body + size > data.size())
+            size = data.size() - body;
+        if (!memcmp(data.data() + offset, "fmt ", 4) && size >= 16) {
+            format = readLittleEndian(data, body, 2);
+            channels = readLittleEndian(data, body + 2, 2);
+            sampleRate = readLittleEndian(data, body + 4, 4);
+            bitsPerSample = readLittleEndian(data, body + 14, 2);
+            // WAVE_FORMAT_EXTENSIBLE: the real format is the sub-format's first word.
+            if (format == 0xFFFE && size >= 26)
+                format = readLittleEndian(data, body + 24, 2);
+        } else if (!memcmp(data.data() + offset, "data", 4))
+            samples = data.subspan(body, size);
+        offset = body + size + (size & 1);
+    }
+    bool pcm = format == 1 && (bitsPerSample == 8 || bitsPerSample == 16 || bitsPerSample == 24 || bitsPerSample == 32);
+    bool floats = format == 3 && bitsPerSample == 32;
+    if (!(pcm || floats) || !channels || !sampleRate || samples.empty())
+        return nullptr;
+
+    size_t bytesPerSample = bitsPerSample / 8;
+    size_t frames = samples.size() / (bytesPerSample * channels);
+    auto bus = AudioBus::create(channels, frames);
+    bus->setSampleRate(sampleRate);
+    for (unsigned channel = 0; channel < channels; ++channel) {
+        auto destination = bus->channel(channel)->mutableSpan();
+        for (size_t frame = 0; frame < frames; ++frame) {
+            size_t at = (frame * channels + channel) * bytesPerSample;
+            uint32_t raw = readLittleEndian(samples, at, bytesPerSample);
+            float value;
+            if (floats)
+                value = std::bit_cast<float>(raw);
+            else if (bitsPerSample == 8)
+                value = (static_cast<int>(raw) - 128) / 128.0f;
+            else {
+                // Sign-extend from the sample's width.
+                int shift = 32 - bitsPerSample;
+                value = (static_cast<int32_t>(raw << shift) >> shift) / static_cast<float>(1u << (bitsPerSample - 1));
+            }
+            destination[frame] = value;
+        }
+    }
+    return bus;
+}
+
+static RefPtr<AudioBus> decodeOnHost(std::span<const uint8_t> data, float sampleRate)
+{
+    // The host answers on its main thread, which the engine thread must stay
+    // free to talk to: decoding is asked from WebCore's decoding threads only.
+    if (isMainThread())
+        return nullptr;
+    // On the heap: if the host never answers, the reply it may still write
+    // later must land somewhere valid, so a timed-out reply is leaked.
+    auto* reply = new HostDecodeReply;
+    callOnMainThread([data, sampleRate, reply] {
+        inception_audio_decode(data.data(), data.size(), sampleRate, reply);
+    });
+    auto deadline = MonotonicTime::now() + 60_s;
+    while (!reply->done.load() && MonotonicTime::now() < deadline)
+        emscripten_futex_wait(&reply->done, 0, 1000);
+    if (!reply->done.load())
+        return nullptr;
+    std::unique_ptr<HostDecodeReply> owned { reply };
+    if (reply->done.load() != 1 || !reply->samples)
+        return nullptr;
+    auto bus = AudioBus::create(reply->channels, reply->frames);
+    bus->setSampleRate(reply->sampleRate);
+    for (int channel = 0; channel < reply->channels; ++channel) {
+        auto destination = bus->channel(channel)->mutableSpan();
+        std::copy_n(reply->samples + static_cast<size_t>(channel) * reply->frames, reply->frames, destination.data());
+    }
+    free(reply->samples);
+    return bus;
+}
+
+RefPtr<AudioBus> createBusFromInMemoryAudioFile(std::span<const uint8_t> data, bool mixToMono, float sampleRate)
+{
+    RefPtr bus = decodeWave(data);
+    if (!bus)
+        bus = decodeOnHost(data, sampleRate);
+    if (!bus)
+        return nullptr;
+    if (mixToMono && bus->numberOfChannels() > 1)
+        bus = AudioBus::createByMixingToMono(*bus);
+    if (sampleRate && bus->sampleRate() != sampleRate)
+        bus = AudioBus::createBySampleRateConverting(*bus, false, sampleRate);
+    return bus;
+}
+
+// WebKit's audio resources (the HRTF database) are files in the engine's file
+// system.
+RefPtr<AudioBus> AudioBus::loadPlatformResource(const char* name, float sampleRate)
+{
+    auto contents = FileSystem::readEntireFile(makeString("/usr/share/inception/audio/"_s, String::fromLatin1(name), ".wav"_s));
+    if (!contents)
+        return nullptr;
+    return createBusFromInMemoryAudioFile(contents->span(), false, sampleRate);
+}
+
+} // namespace WebCore
+
+#endif // ENABLE(WEB_AUDIO)
