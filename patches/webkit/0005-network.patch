+
+void CurlStreamScheduler::schedulePass(Seconds delay)
+{
+    if (!delay) {
+        if (m_passQueued)
+            return;
+        m_passQueued = true;
+        RunLoop::mainSingleton().dispatch([this] {
+            m_passQueued = false;
+            runPass();
+        });
+        return;
+    }
+    if (m_passTimerArmed)
+        return;
+    m_passTimerArmed = true;
+    RunLoop::mainSingleton().dispatchAfter(delay, [this] {
+        m_passTimerArmed = false;
+        runPass();
+    });
+}
+
+void CurlStreamScheduler::runPass()
+{
+    bool ranTasks;
+    {
+        Locker locker { m_mutex };
+        ranTasks = !m_taskQueue.isEmpty();
+    }
+    executeTasks();
+
+    fd_set readfds;
+    fd_set writefds;
+    fd_set exceptfds;
+    FD_ZERO(&readfds);
+    FD_ZERO(&writefds);
+    FD_ZERO(&exceptfds);
+
+    int maxfd = -1;
+    for (auto& stream : m_streamList.values())
+        stream->appendMonitoringFd(readfds, writefds, exceptfds, maxfd);
+
+    int ready = 0;
+    if (maxfd >= 0) {
+        struct timeval noWait { 0, 0 };
+        ready = ::select(maxfd + 1, &readfds, &writefds, &exceptfds, &noWait);
+        if (ready < 0) {
+            FD_ZERO(&readfds);
+            FD_ZERO(&writefds);
+            FD_ZERO(&exceptfds);
+        }
+    }
+
+    // Streams may be destroyed by their own failure callbacks' tasks later, never
+    // during this loop: client calls are always posted, not made inline.
+    for (auto& stream : m_streamList.values())
+        stream->tryToTransfer(readfds, writefds, exceptfds);
+
+    if (m_streamList.isEmpty()) {
+        m_immediatePasses = 0;
+        return;
+    }
+
+    constexpr unsigned maxImmediatePasses = 16;
+    if ((ranTasks || ready > 0) && m_immediatePasses < maxImmediatePasses) {
+        ++m_immediatePasses;
+        schedulePass(0_s);
+        return;
+    }
+    m_immediatePasses = 0;
+    schedulePass(8_ms);
+}
