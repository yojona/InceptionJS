+void CurlRequestScheduler::schedulePass(Seconds delay)
+{
+    if (!delay) {
+        if (m_passQueued)
+            return;
+        m_passQueued = true;
+        RunLoop::mainSingleton().dispatch([this] {
+            m_passQueued = false;
+            runPass();
+        });
+        return;
+    }
+    if (m_passTimerArmed)
+        return;
+    m_passTimerArmed = true;
+    RunLoop::mainSingleton().dispatchAfter(delay, [this] {
+        m_passTimerArmed = false;
+        runPass();
+    });
+}
+
+void CurlRequestScheduler::runPass()
+{
+    if (!m_curlMultiHandle)
+        return;
+
+    executeTasks();
+
+    int activeCount = 0;
+    while (m_curlMultiHandle->perform(activeCount) == CURLM_CALL_MULTI_PERFORM) { }
+
+    while (true) {
+        int messagesInQueue = 0;
+        CURLMsg* msg = m_curlMultiHandle->readInfo(messagesInQueue);
+        if (!msg)
+            break;
+        ASSERT(msg->msg == CURLMSG_DONE);
+        if (auto client = m_clientMaps.inlineGet(msg->easy_handle))
+            completeTransfer(client, msg->data.result);
+    }
+
+    bool hasWork;
+    {
+        Locker locker { m_mutex };
+        hasWork = !m_taskQueue.isEmpty() || !m_activeJobs.isEmpty();
+    }
+    if (!hasWork) {
+        m_immediatePasses = 0;
+        return;
+    }
+
+    // Socket readiness arrives through pumpNow(); the timer only covers curl's
+    // internal deadlines (TLS, HTTP/2 pings, retries). Cap how often a zero
+    // timeout re-queues so a busy transfer cannot starve rendering.
+    long timeoutMS = -1;
+    m_curlMultiHandle->timeout(timeoutMS);
+    constexpr unsigned maxImmediatePasses = 16;
+    if (!timeoutMS && m_immediatePasses < maxImmediatePasses) {
+        ++m_immediatePasses;
+        schedulePass(0_s);
+        return;
+    }
+    m_immediatePasses = 0;
+    constexpr long pollIntervalMS = 8;
+    long delayMS = timeoutMS < 0 ? pollIntervalMS : std::clamp(timeoutMS, 1L, pollIntervalMS);
+    schedulePass(Seconds::fromMilliseconds(delayMS));
+}
