Treat the Emscripten target as an unknown CPU.

The toolchain file reports x86, which would select x86 SIMD sources and flags
(Skia, among others). wasm32 has no CPU-specific paths.

diff --git a/Source/cmake/WebKitCommon.cmake b/Source/cmake/WebKitCommon.cmake
index cda5331..83d94f3 100644
--- a/Source/cmake/WebKitCommon.cmake
+++ b/Source/cmake/WebKitCommon.cmake
@@ -100,7 +100,11 @@ if (NOT HAS_RUN_WEBKIT_COMMON)
     else ()
         string(TOLOWER ${CMAKE_SYSTEM_PROCESSOR} LOWERCASE_CMAKE_SYSTEM_PROCESSOR)
     endif ()
-    if (LOWERCASE_CMAKE_SYSTEM_PROCESSOR MATCHES "(^aarch64|^arm64|^cortex-?[am][2-7][2-8])")
+    # The Emscripten toolchain file reports an x86 processor; the target is wasm32,
+    # which has no CPU-specific code paths in WebKit.
+    if (CMAKE_SYSTEM_NAME STREQUAL "Emscripten")
+        set(WTF_CPU_UNKNOWN 1)
+    elseif (LOWERCASE_CMAKE_SYSTEM_PROCESSOR MATCHES "(^aarch64|^arm64|^cortex-?[am][2-7][2-8])")
          if (FORCE_32BIT)
             set(WTF_CPU_ARM 1)
         else ()
