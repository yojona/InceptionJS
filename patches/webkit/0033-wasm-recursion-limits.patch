 {
+#if PLATFORM(EMSCRIPTEN)
+    CLoopEntryScope scope;
+#endif
     JSValue result = CLoop::execute(llint_vm_entry_to_native, executableAddress, vm, protoCallFrame);
     return JSValue::encode(result);
 }
