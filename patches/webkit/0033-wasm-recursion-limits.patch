diff --git a/Source/JavaScriptCore/runtime/VM.h b/Source/JavaScriptCore/runtime/VM.h
index da952a8..9ed606b 100644
--- a/Source/JavaScriptCore/runtime/VM.h
+++ b/Source/JavaScriptCore/runtime/VM.h
@@ -231,6 +231,13 @@ private:
 enum VMIdentifierType { };
 using VMIdentifier = AtomicObjectIdentifier<VMIdentifierType>;
 
+#if PLATFORM(EMSCRIPTEN)
+// Interpreter entries nested on this thread (LLIntThunks.cpp), and how many
+// the engine's stack holds with room to spare.
+extern thread_local unsigned cloopEntryDepth;
+constexpr unsigned maxCLoopEntryDepth = 160;
+#endif
+
 class VM : public ThreadSafeRefCountedWithSuppressingSaferCPPChecking<VM> {
     WTF_DEPRECATED_MAKE_FAST_ALLOCATED_WITH_HEAP_IDENTIFIER(VM, VM);
 public:
@@ -1194,6 +1201,15 @@ private:
     bool isSafeToRecurse(void* stackLimit) const
     {
         void* curr = currentStackPointer();
+#if PLATFORM(EMSCRIPTEN)
+        // In WebAssembly most of a native frame lives on the engine's own
+        // stack, which the stack pointer does not see: deep native recursion
+        // overflows it long before the limit above trips. Each nested entry
+        // into the interpreter is the expensive part, so their count is
+        // limited as well.
+        if (cloopEntryDepth >= maxCLoopEntryDepth)
+            return false;
+#endif
         return curr >= stackLimit;
     }
 
