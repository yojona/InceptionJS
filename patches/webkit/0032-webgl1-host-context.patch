+// WebGL 1 takes unsized internal formats only. WebCore sizes the ones whose
+// format comes from an extension (float and half-float types, depth, sRGB)
+// for ES 3 drivers; those go back to the format. Anything else a page passes
+// reaches the host as is, so its errors are WebGL 1's.
+static GLenum webGL1BaseFormat(GLenum internalformat)
+{
+    switch (internalformat) {
+    case GL_RGBA8: case GL_RGBA32F: case GL_RGBA16F: case GL_RGBA4: case GL_RGB5_A1: return GL_RGBA;
+    case GL_RGB8: case GL_RGB32F: case GL_RGB16F: case GL_RGB565: return GL_RGB;
+    case 0x8C43 /* SRGB8_ALPHA8 */: return 0x8C42 /* SRGB_ALPHA_EXT */;
+    case 0x8C41 /* SRGB8 */: return 0x8C40 /* SRGB_EXT */;
+    case 0x8816 /* ALPHA32F_EXT */: case 0x881C /* ALPHA16F_EXT */: case 0x803C /* ALPHA8_EXT */: return GL_ALPHA;
+    case 0x8818 /* LUMINANCE32F_EXT */: case 0x881E /* LUMINANCE16F_EXT */: case 0x8040 /* LUMINANCE8_EXT */: return GL_LUMINANCE;
+    case 0x8819 /* LUMINANCE_ALPHA32F_EXT */: case 0x881F /* LUMINANCE_ALPHA16F_EXT */: case 0x8045 /* LUMINANCE8_ALPHA8_EXT */: return GL_LUMINANCE_ALPHA;
+    case GL_DEPTH_COMPONENT16: case GL_DEPTH_COMPONENT24: case GL_DEPTH_COMPONENT32F: return GL_DEPTH_COMPONENT;
+    case GL_DEPTH24_STENCIL8: return GL_DEPTH_STENCIL;
+    default: return internalformat;
+    }
+}
+
+static bool currentIsWebGL1()
+{
+    auto* context = GraphicsContextGLEmscripten::current();
+    return context && !context->isWebGL2();
+}
+
+static bool isSizedByWebCore(GLenum format, GLenum type)
+{
+    switch (type) {
+    case GL_FLOAT:
+    case GL_HALF_FLOAT:
+    case 0x8D61: // HALF_FLOAT_OES
+        return true;
+    default:
+        break;
+    }
+    switch (format) {
+    case GL_DEPTH_COMPONENT:
+    case GL_DEPTH_STENCIL:
+    case 0x8C40: // SRGB_EXT
+    case 0x8C42: // SRGB_ALPHA_EXT
+        return true;
+    default:
+        return false;
+    }
+}
+
+void GL_TexImage2D(GLenum target, GLint level, GLint internalformat, GLsizei width, GLsizei height, GLint border, GLenum format, GLenum type, const void* pixels)
+{
+    if (currentIsWebGL1() && static_cast<GLenum>(internalformat) != format && webGL1BaseFormat(internalformat) == format && isSizedByWebCore(format, type))
+        internalformat = format;
+    glTexImage2D(target, level, internalformat, width, height, border, format, type, pixels);
+}
+
+void GL_CopyTexImage2D(GLenum target, GLint level, GLenum internalformat, GLint x, GLint y, GLsizei width, GLsizei height, GLint border)
+{
+    if (currentIsWebGL1())
+        internalformat = webGL1BaseFormat(internalformat);
+    glCopyTexImage2D(target, level, internalformat, x, y, width, height, border);
+}
