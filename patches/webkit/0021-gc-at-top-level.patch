+
+#if PLATFORM(EMSCRIPTEN)
+// Past this much allocation, a long task without a top-level turn collects
+// where it stands, as before: a likely-safe collection beats certain OOM.
+static constexpr size_t deferredCollectionAllocationLimit = 512 * MB;
+
+void Heap::deferCollectionsToTopLevel(Function<void()>&& wake)
+{
+    m_defersCollectionsToTopLevel = true;
+    m_wakeForDeferredCollections = WTF::move(wake);
+}
+
+void Heap::runDeferredCollections()
+{
+    if (m_deferredRequests.isEmpty())
+        return;
+    auto requests = std::exchange(m_deferredRequests, { });
+    SetForScope atTopLevel(m_isAtTopLevel, true);
+    for (auto& request : requests)
+        collectAsync(WTF::move(request));
+    stopIfNecessary();
 }
+#endif
 
 Heap::Ticket Heap::requestCollection(GCRequest request)
 {
+#if PLATFORM(EMSCRIPTEN)
+    if (m_defersCollectionsToTopLevel && !m_isAtTopLevel && totalBytesAllocatedThisCycle() < deferredCollectionAllocationLimit) {
+        bool wasEmpty = m_deferredRequests.isEmpty();
+        m_deferredRequests.append(WTF::move(request));
+        if (wasEmpty && m_wakeForDeferredCollections)
+            m_wakeForDeferredCollections();
+        // Nothing to wait for here: synchronous callers carry on and the
+        // collection happens at the next top-level turn.
+        return m_lastServedTicket;
+    }
+#endif
     stopIfNecessary();
     
     ASSERT(vm().currentThreadIsHoldingAPILock());
