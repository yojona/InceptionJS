 #include <cstring>
 #include <emscripten/em_js.h>
 #include <emscripten/html5_webgl.h>
@@ -56,25 +57,40 @@ EM_JS(void, inceptionGetInternalformativ, (GLenum target, GLenum internalformat,
 
 namespace WebCore {
 
-// Skia classifies "OpenGL ES 3.0 (WebGL 2.0 ...)" as the WebGL standard, whose
-// interface is compiled out of this Skia build. Under WebGL2 the GLES 3.0
-// interface is the right one, so the version string stops before "(WebGL".
+// WebGL reports itself in two strings Skia does not parse:
+//   GL_VERSION                   "OpenGL ES 3.0 (WebGL 2.0 (...))"
+//   GL_SHADING_LANGUAGE_VERSION  "WebGL GLSL ES 3.00 (...)"
+// The first would select Skia's WebGL interface, which this Skia build leaves
+// out; under WebGL2 the GLES 3.0 interface is the right one. The second would
+// make the GLSL version invalid. Both are rewritten to their GLES forms.
+static const GLubyte* rewriteVersion(const GLubyte* value, const char* dropPrefix, const char* addPrefix, std::array<char, 64>& storage)
+{
+    if (storage[0])
+        return reinterpret_cast<const GLubyte*>(storage.data());
+    const char* source = reinterpret_cast<const char*>(value);
+    size_t dropLength = strlen(dropPrefix);
+    if (!strncmp(source, dropPrefix, dropLength))
+        source += dropLength;
+    const char* cut = strstr(source, " (");
+    size_t length = cut ? static_cast<size_t>(cut - source) : strlen(source);
+    snprintf(storage.data(), storage.size(), "%s%.*s", addPrefix, static_cast<int>(length), source);
+    return reinterpret_cast<const GLubyte*>(storage.data());
+}
+
 static const GLubyte* GL_APIENTRY getStringForSkia(GLenum name)
 {
     const GLubyte* value = glGetString(name);
-    if (name != GL_VERSION || !value)
