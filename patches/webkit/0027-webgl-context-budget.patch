@@ -99,10 +99,19 @@ WTF_MAKE_TZONE_ALLOCATED_IMPL(GraphicsContextGLEmscripten);
 static GraphicsContextGLEmscripten* s_current;
 
 // Browsers cap live WebGL contexts and lose the oldest past the cap, which
-// would be the engine's own. The cap varies: sixteen on a desktop GPU, four in
-// a headless or software-rendered browser. Pages get few enough to stay under
-// the smallest; past that their oldest context is lost, as a browser would do.
-static constexpr size_t maxPageContexts = 3;
+// would be the engine's own. The cap follows the host's renderer (sixteen on a
+// GPU, four on a software rasterizer) or the embedder's setting; the engine
+// derives it when it creates its own context. Past it, the page's oldest
+// context is lost, as a browser would do.
+EM_JS(int, inception_webgl_page_context_cap, (), {
+    return globalThis.inceptionPageContextCap | 0;
+});
+
+static size_t maxPageContexts()
+{
+    int cap = inception_webgl_page_context_cap();
+    return cap > 0 ? cap : 3;
+}
 
