 #endif
 WTF_IGNORE_WARNINGS_IN_THIRD_PARTY_CODE_END
 
+#if PLATFORM(EMSCRIPTEN)
+// The embedder learns which characters no bundled font has, and can load a
+// font that has them (fonts it does not bundle at startup).
+extern "C" void inception_font_fallback(char32_t);
+#endif
+
 namespace WebCore {
 
