diff --git a/Source/WebCore/crypto/openssl/CryptoAlgorithmHKDFOpenSSL.cpp b/Source/WebCore/crypto/openssl/CryptoAlgorithmHKDFOpenSSL.cpp
index 8b80eb4..f8eb554 100644
--- a/Source/WebCore/crypto/openssl/CryptoAlgorithmHKDFOpenSSL.cpp
+++ b/Source/WebCore/crypto/openssl/CryptoAlgorithmHKDFOpenSSL.cpp
@@ -30,7 +30,11 @@
 #include "CryptoKeyRaw.h"
 #include "ExceptionOr.h"
 #include "OpenSSLUtilities.h"
+#if defined(OPENSSL_IS_BORINGSSL)
 #include <openssl/hkdf.h>
+#else
+#include <openssl/kdf.h>
+#endif
 
 namespace WebCore {
 
@@ -41,8 +45,23 @@ ExceptionOr<Vector<uint8_t>> CryptoAlgorithmHKDF::platformDeriveBits(const Crypt
         return Exception { ExceptionCode::NotSupportedError };
 
     Vector<uint8_t> output(length / 8);
+#if !defined(OPENSSL_IS_BORINGSSL)
+    // OpenSSL has no one-shot HKDF(); it derives through an EVP_PKEY context.
+    auto context = EvpPKeyCtxPtr(EVP_PKEY_CTX_new_id(EVP_PKEY_HKDF, nullptr));
+    size_t outputLength = output.size();
+    if (!context
+        || EVP_PKEY_derive_init(context.get()) <= 0
+        || EVP_PKEY_CTX_set_hkdf_md(context.get(), algorithm) <= 0
+        || EVP_PKEY_CTX_set1_hkdf_salt(context.get(), parameters.saltVector().span().data(), parameters.saltVector().size()) <= 0
+        || EVP_PKEY_CTX_set1_hkdf_key(context.get(), key.key().span().data(), key.key().size()) <= 0
+        || EVP_PKEY_CTX_add1_hkdf_info(context.get(), parameters.infoVector().span().data(), parameters.infoVector().size()) <= 0
+        || EVP_PKEY_derive(context.get(), output.mutableSpan().data(), &outputLength) <= 0
+        || outputLength != output.size())
+        return Exception { ExceptionCode::OperationError };
+#else
     if (HKDF(output.mutableSpan().data(), output.size(), algorithm, key.key().span().data(), key.key().size(), parameters.saltVector().span().data(), parameters.saltVector().size(), parameters.infoVector().span().data(), parameters.infoVector().size()) <= 0)
         return Exception { ExceptionCode::OperationError };
+#endif
 
     return output;
 }
