 {
+#if PLATFORM(EMSCRIPTEN)
+    // A worker on the engine thread cannot wait for bytes that only arrive when that
+    // thread returns to its loop. Fail like a network error instead of hanging.
+    UNUSED_PARAM(workerOrWorkletGlobalScope);
+    UNUSED_PARAM(options);
+    client.didFail(std::nullopt, ResourceError { errorDomainWebKitInternal, 0, request.url(), "Synchronous loads in workers are not supported by this engine"_s });
+    return;
+#endif
     WorkerRunLoop& runLoop = workerOrWorkletGlobalScope.workerOrWorkletThread()->runLoop();
 
     // Create a unique mode just for this synchronous resource load.
diff --git a/Source/WebCore/platform/graphics/ImageFrameWorkQueue.cpp b/Source/WebCore/platform/graphics/ImageFrameWorkQueue.cpp
index 1c8e16f..58f004e 100644
--- a/Source/WebCore/platform/graphics/ImageFrameWorkQueue.cpp
+++ b/Source/WebCore/platform/graphics/ImageFrameWorkQueue.cpp
@@ -114,10 +114,29 @@ void ImageFrameWorkQueue::dispatch(const Request& request)
 {
     ASSERT(isMainThread());
 
+#if PLATFORM(EMSCRIPTEN)
+    // The request queue makes the decoder thread and this one wait on each other,
+    // which one thread cannot do. Decode on a later turn of the engine loop, with
+    // the same checks the asynchronous path makes when the result comes back.
+    RefPtr decoder = protectedSource()->decoder();
+    if (!decoder)
+        return;
+    decodeQueue().append(request);
+    callOnMainThread([protectedThis = Ref { *this }, source = protectedSource(), decoder = decoder.releaseNonNull(), request] () mutable {
+        if (source.ptr() != protectedThis->m_source.get())
+            return;
+        if (protectedThis->decodeQueue().isEmpty() || protectedThis->decodeQueue().first() != request)
+            return;
+        RefPtr nativeImage = NativeImage::create(decoder->createFrameImageAtIndex(request.index, request.subsamplingLevel, request.options));
+        protectedThis->decodeQueue().removeFirst();
+        source->imageFrameDecodeAtIndexHasFinished(request.index, request.subsamplingLevel, request.animatingState, request.options, WTF::move(nativeImage));
+    });
+#else
     requestQueue().enqueue(request);
     decodeQueue().append(request);
 
     start();
+#endif
 }
 
