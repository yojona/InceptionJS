Skia's GLES interface over WebGL2.

WebKit builds Skia for GLES only. WebGL2 reports "OpenGL ES 3.0 (WebGL 2.0
...)", which Skia parses as version 2.0, and under GLES rules a 2.0 context
cannot render to RGBA8; the port reports "OpenGL ES 3.0" instead (this
replaces the broader string rewriting of the graphics patch).
glGetInternalformativ is answered from WebGL2's SAMPLES query: the toolchain
leaves NUM_SAMPLE_COUNTS unwritten and Skia would read garbage.

diff --git a/Source/WebCore/platform/graphics/emscripten/SkiaGLInterfaceEmscripten.cpp b/Source/WebCore/platform/graphics/emscripten/SkiaGLInterfaceEmscripten.cpp
index 62a9cb6..b0a8057 100644
--- a/Source/WebCore/platform/graphics/emscripten/SkiaGLInterfaceEmscripten.cpp
+++ b/Source/WebCore/platform/graphics/emscripten/SkiaGLInterfaceEmscripten.cpp
@@ -28,7 +28,7 @@
 #if USE(SKIA)
 
 #include <GLES3/gl3.h>
-#include <algorithm>
+#include <cstdio>
 #include <cstring>
 #include <emscripten/em_js.h>
 #include <emscripten/html5_webgl.h>
@@ -37,12 +37,12 @@ WTF_IGNORE_WARNINGS_IN_THIRD_PARTY_CODE_BEGIN
 #include <skia/gpu/ganesh/gl/GrGLAssembleInterface.h>
 WTF_IGNORE_WARNINGS_IN_THIRD_PARTY_CODE_END
 
-// WebGL2 exposes only sample counts through getInternalformatParameter, and
-// the toolchain's GL layer has no entry point for it. Skia asks for nothing else.
+// WebGL2's getInternalformatParameter answers only SAMPLES; asked for
+// NUM_SAMPLE_COUNTS, the toolchain's glGetInternalformativ writes nothing and
+// Skia reads garbage, deciding no format can be rendered to. Both queries are
+// answered from the SAMPLES list.
 EM_JS(void, inceptionGetInternalformativ, (GLenum target, GLenum internalformat, GLenum pname, GLsizei bufSize, GLint* params), {
-    const samples = GLctx.getInternalformatParameter(target, internalformat, 0x80A9 /* SAMPLES */);
-    if (!samples)
-        return;
+    const samples = GLctx.getInternalformatParameter(target, internalformat, 0x80A9 /* SAMPLES */) || [];
     if (pname == 0x9380 /* NUM_SAMPLE_COUNTS */) {
         if (bufSize > 0)
             HEAP32[params >> 2] = samples.length;
@@ -56,23 +56,21 @@ EM_JS(void, inceptionGetInternalformativ, (GLenum target, GLenum internalformat,
 
 namespace WebCore {
 
-// Skia classifies "OpenGL ES 3.0 (WebGL 2.0 ...)" as the WebGL standard, whose
-// interface is compiled out of this Skia build. Under WebGL2 the GLES 3.0
-// interface is the right one, so the version string stops before "(WebGL".
+// WebKit builds Skia for GLES only (SK_ASSUME_GL_ES). WebGL2 reports
+// "OpenGL ES 3.0 (WebGL 2.0 ...)", which Skia parses as version 2.0, and
+// under GLES rules a 2.0 context cannot render to RGBA8. Reporting the GLES
+// version WebGL2 actually implements, "OpenGL ES 3.0", fixes that.
 static const GLubyte* GL_APIENTRY getStringForSkia(GLenum name)
 {
     const GLubyte* value = glGetString(name);
     if (name != GL_VERSION || !value)
         return value;
-
     static char version[32];
     if (!version[0]) {
         const char* source = reinterpret_cast<const char*>(value);
         const char* cut = strstr(source, " (");
         size_t length = cut ? static_cast<size_t>(cut - source) : strlen(source);
-        length = std::min(length, sizeof(version) - 1);
-        memcpy(version, source, length);
-        version[length] = '\0';
+        snprintf(version, sizeof(version), "%.*s", static_cast<int>(length), source);
     }
     return reinterpret_cast<const GLubyte*>(version);
 }
