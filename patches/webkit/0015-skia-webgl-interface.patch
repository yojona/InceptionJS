@@ -32,7 +32,7 @@ WTF_IGNORE_WARNINGS_IN_THIRD_PARTY_CODE_END
 
 namespace WebCore {
 
-// Skia's GLES interface, assembled over WebGL2 entry points.
+// Skia's GL interface over the WebGL2 entry points.
 sk_sp<const GrGLInterface> makeSkiaGLInterfaceForWebGL();
 
 } // namespace WebCore
