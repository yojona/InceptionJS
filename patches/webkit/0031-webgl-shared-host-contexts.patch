+void GL_VertexAttrib4fv(GLuint index, const GLfloat* v) { GL_VertexAttrib4f(index, v[0], v[1], v[2], v[3]); }
+
+void GL_VertexAttrib4f(GLuint index, GLfloat x, GLfloat y, GLfloat z, GLfloat w)
+{
+    recordVertexAttrib(index, ShadowVertexAttrib::Kind::Float, floatBits(x, y, z, w));
+    glVertexAttrib4f(index, x, y, z, w);
+}
+
+void GL_VertexAttribI4i(GLuint index, GLint x, GLint y, GLint z, GLint w)
+{
+    recordVertexAttrib(index, ShadowVertexAttrib::Kind::Int, { static_cast<uint32_t>(x), static_cast<uint32_t>(y), static_cast<uint32_t>(z), static_cast<uint32_t>(w) });
+    glVertexAttribI4i(index, x, y, z, w);
+}
+
+void GL_VertexAttribI4iv(GLuint index, const GLint* v) { GL_VertexAttribI4i(index, v[0], v[1], v[2], v[3]); }
+
+void GL_VertexAttribI4ui(GLuint index, GLuint x, GLuint y, GLuint z, GLuint w)
+{
+    recordVertexAttrib(index, ShadowVertexAttrib::Kind::UnsignedInt, { x, y, z, w });
+    glVertexAttribI4ui(index, x, y, z, w);
+}
+
+void GL_VertexAttribI4uiv(GLuint index, const GLuint* v) { GL_VertexAttribI4ui(index, v[0], v[1], v[2], v[3]); }
+
+GLenum GL_GetError()
+{
+    if (auto* state = GraphicsContextGLEmscripten::currentState(); state && !state->pendingErrors.isEmpty())
+    {
+        GLenum error = state->pendingErrors.first();
+        state->pendingErrors.removeAt(0);
+        return error;
+    }
+    return glGetError();
+}
+
+// The stand-ins report as the default objects they replace.
+void GL_GetIntegerv(GLenum pname, GLint* data)
+{
+    glGetIntegerv(pname, data);
+    auto* context = GraphicsContextGLEmscripten::current();
+    if (!context || !data)
+        return;
+    if (pname == GL_VERTEX_ARRAY_BINDING && static_cast<GLuint>(*data) == context->defaultVertexArray())
+        *data = 0;
+    else if (pname == GL_TRANSFORM_FEEDBACK_BINDING && static_cast<GLuint>(*data) == context->defaultTransformFeedback())
+        *data = 0;
+}
+
+// Object lifetimes: each context remembers what it created, and bindings to
+// deleted objects revert to 0 in its shadow as they do on the host.
+static void addOwned(HashSet<GLuint> VirtualGLContextState::* set, GLsizei n, const GLuint* names)
+{
+    auto* state = GraphicsContextGLEmscripten::currentState();
+    if (!state || !names)
+        return;
+    for (GLsizei i = 0; i < n; ++i) {
+        if (names[i])
+            (state->*set).add(names[i]);
+    }
+}
+
+static void removeOwned(HashSet<GLuint> VirtualGLContextState::* set, GLsizei n, const GLuint* names, const Function<void(GLStateShadow&, GLuint)>& unbind)
+{
+    auto* state = GraphicsContextGLEmscripten::currentState();
+    if (!state || !names)
+        return;
+    for (GLsizei i = 0; i < n; ++i) {
+        if (!names[i])
+            continue;
+        (state->*set).remove(names[i]);
+        unbind(state->gl, names[i]);
+    }
+}
+
+static void clear(GLuint& binding, GLuint name)
+{
+    if (binding == name)
+        binding = 0;
+}
+
+void GL_GenBuffers(GLsizei n, GLuint* buffers) { glGenBuffers(n, buffers); addOwned(&VirtualGLContextState::buffers, n, buffers); }
+void GL_GenFramebuffers(GLsizei n, GLuint* framebuffers) { glGenFramebuffers(n, framebuffers); addOwned(&VirtualGLContextState::framebuffers, n, framebuffers); }
+void GL_GenQueries(GLsizei n, GLuint* ids) { glGenQueries(n, ids); addOwned(&VirtualGLContextState::queries, n, ids); }
+void GL_GenQueriesEXT(GLsizei n, GLuint* ids) { glGenQueriesEXT(n, ids); addOwned(&VirtualGLContextState::queries, n, ids); }
+void GL_GenRenderbuffers(GLsizei n, GLuint* renderbuffers) { glGenRenderbuffers(n, renderbuffers); addOwned(&VirtualGLContextState::renderbuffers, n, renderbuffers); }
+void GL_GenSamplers(GLsizei n, GLuint* samplers) { glGenSamplers(n, samplers); addOwned(&VirtualGLContextState::samplers, n, samplers); }
+void GL_GenTextures(GLsizei n, GLuint* textures) { glGenTextures(n, textures); addOwned(&VirtualGLContextState::textures, n, textures); }
+void GL_GenTransformFeedbacks(GLsizei n, GLuint* ids) { glGenTransformFeedbacks(n, ids); addOwned(&VirtualGLContextState::transformFeedbacks, n, ids); }
+void GL_GenVertexArrays(GLsizei n, GLuint* arrays) { glGenVertexArrays(n, arrays); addOwned(&VirtualGLContextState::vertexArrays, n, arrays); }
+void GL_GenVertexArraysOES(GLsizei n, GLuint* arrays) { glGenVertexArraysOES(n, arrays); addOwned(&VirtualGLContextState::vertexArrays, n, arrays); }
+
+GLuint GL_CreateProgram()
+{
+    GLuint program = glCreateProgram();
+    addOwned(&VirtualGLContextState::programs, 1, &program);
+    return program;
+}
+
+GLuint GL_CreateShader(GLenum type)
+{
+    GLuint shader = glCreateShader(type);
+    addOwned(&VirtualGLContextState::shaders, 1, &shader);
+    return shader;
+}
+
+void GL_DeleteBuffers(GLsizei n, const GLuint* buffers)
+{
+    removeOwned(&VirtualGLContextState::buffers, n, buffers, [](GLStateShadow& gl, GLuint name) {
+        for (auto* binding : { &gl.arrayBuffer, &gl.copyReadBuffer, &gl.copyWriteBuffer, &gl.pixelPackBuffer, &gl.pixelUnpackBuffer, &gl.uniformBuffer, &gl.transformFeedbackBuffer })
+            clear(*binding, name);
+        for (auto& range : gl.uniformBindings) {
+            if (range.buffer == name)
+                range = { };
+        }
+    });
+    glDeleteBuffers(n, buffers);
+}
+
+void GL_DeleteFramebuffers(GLsizei n, const GLuint* framebuffers)
+{
+    removeOwned(&VirtualGLContextState::framebuffers, n, framebuffers, [](GLStateShadow& gl, GLuint name) {
+        clear(gl.drawFramebuffer, name);
+        clear(gl.readFramebuffer, name);
+    });
+    glDeleteFramebuffers(n, framebuffers);
+}
+
+void GL_DeleteRenderbuffers(GLsizei n, const GLuint* renderbuffers)
+{
+    removeOwned(&VirtualGLContextState::renderbuffers, n, renderbuffers, [](GLStateShadow& gl, GLuint name) {
+        clear(gl.renderbuffer, name);
+    });
+    glDeleteRenderbuffers(n, renderbuffers);
+}
+
+void GL_DeleteSamplers(GLsizei n, const GLuint* samplers)
+{
+    removeOwned(&VirtualGLContextState::samplers, n, samplers, [](GLStateShadow& gl, GLuint name) {
+        for (auto& unit : gl.textureUnits)
+            clear(unit.sampler, name);
+    });
+    glDeleteSamplers(n, samplers);
+}
+
+void GL_DeleteTextures(GLsizei n, const GLuint* textures)
+{
+    removeOwned(&VirtualGLContextState::textures, n, textures, [](GLStateShadow& gl, GLuint name) {
+        for (auto& unit : gl.textureUnits) {
+            for (auto* binding : { &unit.texture2D, &unit.textureCubeMap, &unit.texture3D, &unit.texture2DArray })
+                clear(*binding, name);
+        }
+    });
+    glDeleteTextures(n, textures);
+}
+
+void GL_DeleteQueries(GLsizei n, const GLuint* ids)
+{
+    removeOwned(&VirtualGLContextState::queries, n, ids, [](GLStateShadow&, GLuint) { });
+    glDeleteQueries(n, ids);
+}
+
+void GL_DeleteQueriesEXT(GLsizei n, const GLuint* ids)
+{
+    removeOwned(&VirtualGLContextState::queries, n, ids, [](GLStateShadow&, GLuint) { });
+    glDeleteQueriesEXT(n, ids);
+}
+
+// Deleting the bound vertex array or transform feedback reverts to the
+// default one, which here is the context's stand-in.
+void GL_DeleteVertexArrays(GLsizei n, const GLuint* arrays)
+{
+    auto* context = GraphicsContextGLEmscripten::current();
+    bool wasBound = false;
+    removeOwned(&VirtualGLContextState::vertexArrays, n, arrays, [&](GLStateShadow& gl, GLuint name) {
+        if (gl.vertexArray == name) {
+            wasBound = true;
+            gl.vertexArray = 0;
+        }
+    });
+    glDeleteVertexArrays(n, arrays);
+    if (wasBound && context)
+        GL_BindVertexArray(0);
+}
+
+void GL_DeleteVertexArraysOES(GLsizei n, const GLuint* arrays)
+{
+    GL_DeleteVertexArrays(n, arrays);
+}
+
+void GL_DeleteTransformFeedbacks(GLsizei n, const GLuint* ids)
+{
+    auto* context = GraphicsContextGLEmscripten::current();
+    bool wasBound = false;
+    removeOwned(&VirtualGLContextState::transformFeedbacks, n, ids, [&](GLStateShadow& gl, GLuint name) {
+        if (gl.transformFeedback == name) {
+            wasBound = true;
+            gl.transformFeedback = 0;
+        }
+    });
+    glDeleteTransformFeedbacks(n, ids);
+    if (wasBound && context)
+        GL_BindTransformFeedback(GL_TRANSFORM_FEEDBACK, 0);
+}
+
+void GL_DeleteShader(GLuint shader)
+{
+    removeOwned(&VirtualGLContextState::shaders, 1, &shader, [](GLStateShadow&, GLuint) { });
+    glDeleteShader(shader);
+}
+
+// A program deleted while current stays usable there; on a shared host the
+// next context's state would unbind it, so the host deletes it only once
+// unused.
+void GL_DeleteProgram(GLuint program)
+{
+    auto* context = GraphicsContextGLEmscripten::current();
+    auto* state = GraphicsContextGLEmscripten::currentState();
+    if (state)
+        state->programs.remove(program);
+    if (context && context->isShared() && state && state->gl.program == program && program) {
+        sharedHost(context->isWebGL2()).pendingProgramDeletes.add(program);
+        return;
+    }
+    glDeleteProgram(program);
+}
+
 #endif // ENABLE(WEBGL)
