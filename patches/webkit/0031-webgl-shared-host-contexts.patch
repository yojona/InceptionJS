+static void recordCapability(GLenum capability, bool enabled)
+{
+    auto* gl = shadow();
+    if (!gl)
+        return;
+    if (capability == GL_BLEND) {
+        gl->blend.enabled = enabled;
+        for (auto& blend : gl->blendPerDrawBuffer)
+            blend.enabled = enabled;
+        return;
+    }
+    if (auto index = capabilityIndex(capability)) {
+        if (enabled)
+            gl->enabled |= 1u << *index;
+        else
+            gl->enabled &= ~(1u << *index);
+    }
+}
