+#include "config.h"
+#include "SkiaGLInterfaceEmscripten.h"
+
+#if USE(SKIA)
+
+#include <GLES3/gl3.h>
+#include <algorithm>
+#include <cstring>
+#include <emscripten/em_js.h>
+#include <emscripten/html5_webgl.h>
+
+WTF_IGNORE_WARNINGS_IN_THIRD_PARTY_CODE_BEGIN
+#include <skia/gpu/ganesh/gl/GrGLAssembleInterface.h>
+WTF_IGNORE_WARNINGS_IN_THIRD_PARTY_CODE_END
+
+// WebGL2 exposes only sample counts through getInternalformatParameter, and
+// the toolchain's GL layer has no entry point for it. Skia asks for nothing else.
+EM_JS(void, inceptionGetInternalformativ, (GLenum target, GLenum internalformat, GLenum pname, GLsizei bufSize, GLint* params), {
+    const samples = GLctx.getInternalformatParameter(target, internalformat, 0x80A9 /* SAMPLES */);
+    if (!samples)
+        return;
+    if (pname == 0x9380 /* NUM_SAMPLE_COUNTS */) {
+        if (bufSize > 0)
+            HEAP32[params >> 2] = samples.length;
+        return;
+    }
+    if (pname == 0x80A9) {
+        for (let i = 0; i < Math.min(bufSize, samples.length); i++)
+            HEAP32[(params >> 2) + i] = samples[i];
+    }
+});
+
+namespace WebCore {
+
+// Skia classifies "OpenGL ES 3.0 (WebGL 2.0 ...)" as the WebGL standard, whose
+// interface is compiled out of this Skia build. Under WebGL2 the GLES 3.0
+// interface is the right one, so the version string stops before "(WebGL".
+static const GLubyte* GL_APIENTRY getStringForSkia(GLenum name)
+{
+    const GLubyte* value = glGetString(name);
+    if (name != GL_VERSION || !value)
+        return value;
+
+    static char version[32];
+    if (!version[0]) {
+        const char* source = reinterpret_cast<const char*>(value);
+        const char* cut = strstr(source, " (");
+        size_t length = cut ? static_cast<size_t>(cut - source) : strlen(source);
+        length = std::min(length, sizeof(version) - 1);
+        memcpy(version, source, length);
+        version[length] = '\0';
+    }
+    return reinterpret_cast<const GLubyte*>(version);
+}
+
+static GrGLFuncPtr getProc(void*, const char* name)
+{
+    if (!strcmp(name, "glGetString"))
+        return reinterpret_cast<GrGLFuncPtr>(getStringForSkia);
+    if (!strcmp(name, "glGetInternalformativ"))
+        return reinterpret_cast<GrGLFuncPtr>(inceptionGetInternalformativ);
+    return reinterpret_cast<GrGLFuncPtr>(emscripten_webgl_get_proc_address(name));
+}
+
+sk_sp<const GrGLInterface> makeSkiaGLInterfaceForWebGL()
+{
+    return GrGLMakeAssembledInterface(nullptr, getProc);
+}
+
+} // namespace WebCore
+
+#endif // USE(SKIA)
