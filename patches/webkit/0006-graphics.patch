+
+namespace WebCore {
+
+SystemFontDatabase& SystemFontDatabase::singleton()
+{
+    static NeverDestroyed<SystemFontDatabase> database = SystemFontDatabase();
+    return database.get();
+}
+
+// There is no desktop to ask: system font keywords resolve to the fontconfig
+// sans-serif family at the sizes desktop browsers use for form controls.
+auto SystemFontDatabase::platformSystemFontShorthandInfo(FontShorthand shorthand) -> SystemFontShorthandInfo
+{
+    static MainThreadNeverDestroyed<const AtomString> family("sans-serif"_s);
+    float size = 13;
+    switch (shorthand) {
+    case FontShorthand::WebkitMiniControl:
+        size = 9;
+        break;
+    case FontShorthand::WebkitSmallControl:
+        size = 11;
+        break;
+    default:
+        break;
+    }
+    return { family.get(), size, normalWeightValue() };
