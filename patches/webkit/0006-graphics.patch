+
+// GLContext for the Emscripten port. It replaces the EGL implementation: every
+// GLContext is a view over the single WebGL2 context the embedder registered,
+// so creation never makes a new context and "sharing" is trivially true.
+
+#include "config.h"
+#include "GLContext.h"
+
+#include "GLDisplay.h"
+#include "PlatformDisplay.h"
+#include "WebGLContextEmscripten.h"
+#include <GLES3/gl3.h>
+#include <wtf/TZoneMallocInlines.h>
+#include <wtf/text/StringToIntegerConversion.h>
+#include <wtf/text/WTFString.h>
+
+namespace WebCore {
+
+WTF_MAKE_TZONE_ALLOCATED_IMPL(GLContext);
+
+static EMSCRIPTEN_WEBGL_CONTEXT_HANDLE s_sharedWebGLContext;
+
+void setSharedWebGLContext(EMSCRIPTEN_WEBGL_CONTEXT_HANDLE handle)
+{
+    s_sharedWebGLContext = handle;
+}
+
+EMSCRIPTEN_WEBGL_CONTEXT_HANDLE sharedWebGLContext()
+{
+    return s_sharedWebGLContext;
+}
+
+static EGLContext toEGLContext(EMSCRIPTEN_WEBGL_CONTEXT_HANDLE handle)
+{
+    return reinterpret_cast<EGLContext>(static_cast<intptr_t>(handle));
+}
+
+static EMSCRIPTEN_WEBGL_CONTEXT_HANDLE toWebGLHandle(EGLContext context)
+{
+    return static_cast<EMSCRIPTEN_WEBGL_CONTEXT_HANDLE>(reinterpret_cast<intptr_t>(context));
+}
+
+static std::unique_ptr<GLContext> createView(GLDisplay& display)
+{
+    if (!s_sharedWebGLContext)
+        return nullptr;
+    return makeUnique<GLContext>(display, toEGLContext(s_sharedWebGLContext), nullptr, nullptr);
+}
+
+const char* GLContext::errorString(int statusCode)
+{
+    switch (statusCode) {
+    case EMSCRIPTEN_RESULT_SUCCESS:
+        return "success";
+    case EMSCRIPTEN_RESULT_INVALID_TARGET:
+        return "invalid target";
+    case EMSCRIPTEN_RESULT_INVALID_PARAM:
+        return "invalid parameter";
+    default:
+        return "unknown error";
+    }
+}
+
+const char* GLContext::lastErrorString()
+{
+    return s_sharedWebGLContext ? "no error" : "no WebGL context registered";
+}
+
+std::unique_ptr<GLContext> GLContext::create(GLDisplay& display, Target, GLContext*, GLNativeWindowType)
+{
+    return createView(display);
+}
+
+std::unique_ptr<GLContext> GLContext::create(PlatformDisplay& platformDisplay, GLNativeWindowType)
+{
+    return createView(platformDisplay.glDisplay());
+}
+
+std::unique_ptr<GLContext> GLContext::createOffscreen(PlatformDisplay& platformDisplay)
+{
+    return createView(platformDisplay.glDisplay());
+}
+
+std::unique_ptr<GLContext> GLContext::createSharing(PlatformDisplay& platformDisplay)
+{
+    return createView(platformDisplay.glDisplay());
+}
+
+GLContext::GLContext(GLDisplay& display, EGLContext context, EGLSurface surface, EGLConfig config)
+    : m_display(display)
+    , m_context(context)
+    , m_surface(surface)
+    , m_config(config)
+{
+}
+
+// The WebGL context belongs to the embedder; a view never destroys it.
+GLContext::~GLContext() = default;
+
+RefPtr<GLDisplay> GLContext::display() const
+{
+    return m_display.get();
+}
+
+bool GLContext::makeCurrentImpl()
+{
+    return emscripten_webgl_make_context_current(toWebGLHandle(m_context)) == EMSCRIPTEN_RESULT_SUCCESS;
+}
+
+bool GLContext::unmakeCurrentImpl()
+{
+    return true;
+}
+
+unsigned GLContext::glVersion() const
+{
+    return version();
+}
+
+bool GLContext::makeContextCurrent()
+{
+    if (isCurrent())
+        return true;
+    if (!makeCurrentImpl())
+        return false;
+    didMakeContextCurrent();
+    return true;
+}
+
+// Views share one context, so leaving it bound is harmless and saves a round
+// trip; only the bookkeeping changes.
+bool GLContext::unmakeContextCurrent()
+{
+    if (isCurrent())
+        didUnmakeContextCurrent();
+    return true;
+}
+
+GLContext* GLContext::current()
+{
+    auto* context = currentContext();
+    if (context && context->type() == GLContextWrapper::Type::Native)
+        return static_cast<GLContext*>(context);
+    return nullptr;
+}
+
+// Frames are presented by the embedder (transferToImageBitmap), not swapped.
+void GLContext::swapBuffers()
+{
+}
+
+GCGLContext GLContext::platformContext() const
+{
+    return m_context;
+}
+
+bool GLContext::isExtensionSupported(const char* extensionList, const char* extension)
+{
+    if (!extensionList || !extension)
+        return false;
+    auto list = StringView::fromLatin1(extensionList);
+    auto name = StringView::fromLatin1(extension);
+    for (auto entry : list.split(' ')) {
+        if (entry == name)
+            return true;
+    }
+    return false;
+}
+
+// WebGL reports "WebGL 2.0 (OpenGL ES 3.0 Chromium)" and the like; read the
+// first "major.minor" token wherever it appears.
+unsigned GLContext::versionFromString(const char* versionString)
+{
+    if (!versionString)
+        return 0;
+    for (auto token : StringView::fromLatin1(versionString).split(' ')) {
+        auto dot = token.find('.');
+        if (dot == notFound)
+            continue;
+        auto major = parseIntegerAllowingTrailingJunk<unsigned>(token.left(dot));
+        auto minor = parseIntegerAllowingTrailingJunk<unsigned>(token.substring(dot + 1));
+        if (major && minor)
+            return *major * 100 + *minor * 10;
+    }
+    return 0;
+}
+
+unsigned GLContext::version() const
+{
+    if (!m_version)
+        m_version = versionFromString(reinterpret_cast<const char*>(glGetString(GL_VERSION)));
+    return m_version;
+}
+
+// None of these are WebGL extensions, and WebGL2 provides the behavior of the
+// first two in core.
+const GLContext::GLExtensions& GLContext::glExtensions() const
+{
+    m_glExtensions.OES_texture_npot = true;
+    m_glExtensions.EXT_unpack_subimage = true;
+    m_glExtensions.APPLE_sync = false;
+    m_glExtensions.OES_packed_depth_stencil = true;
+    return m_glExtensions;
+}
+
+GLContext::ScopedGLContext::ScopedGLContext(std::unique_ptr<GLContext>&& context)
+    : m_context(WTF::move(context))
+{
+    m_previous.glContext = GLContext::current();
+    if (m_context)
+        m_context->makeContextCurrent();
+}
+
+GLContext::ScopedGLContext::~ScopedGLContext()
+{
+    m_context = nullptr;
+    if (m_previous.glContext)
+        m_previous.glContext->makeContextCurrent();
+}
+
+GLContext::ScopedGLContextCurrent::ScopedGLContextCurrent(GLContext& context)
+    : m_context(context)
+{
+    m_previous.glContext = GLContext::current();
+    m_context.makeContextCurrent();
+}
+
+GLContext::ScopedGLContextCurrent::~ScopedGLContextCurrent()
+{
+    if (m_previous.glContext && m_previous.glContext != &m_context) {
+        m_previous.glContext->makeContextCurrent();
+        return;
+    }
+    if (!m_previous.glContext)
+        m_context.unmakeContextCurrent();
+}
+
+} // namespace WebCore
