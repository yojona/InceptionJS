+void RunLoop::reportNextTimer()
+{
+    std::optional<Seconds> delay;
+    {
+        Locker locker { m_loopLock };
+        if (!m_schedules.isEmpty())
+            delay = std::max(0_s, m_schedules.first()->scheduledTimePoint() - MonotonicTime::now());
