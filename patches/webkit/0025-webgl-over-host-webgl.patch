+// The drawing buffer's color texture; WebCore attaches it and its depth and
+// stencil buffers itself.
+bool GraphicsContextGLEmscripten::reshapeDrawingBuffer()
+{
+    auto size = getInternalFramebufferSize();
+    GLenum format = contextAttributes().alpha ? GL_RGBA : GL_RGB;
+    ScopedRestoreTextureBinding restoreBinding(GL_TEXTURE_BINDING_2D, GL_TEXTURE_2D);
+    GL_BindTexture(GL_TEXTURE_2D, m_texture);
+    GL_TexImage2D(GL_TEXTURE_2D, 0, format, size.width(), size.height(), 0, format, GL_UNSIGNED_BYTE, nullptr);
+    return true;
+}
+
+// The canvas is painted from the drawing buffer as it stands, read back right
+// after the page's frame; nothing is handed to a compositor.
+void GraphicsContextGLEmscripten::prepareForDisplay()
+{
+}
+
+RefPtr<PixelBuffer> GraphicsContextGLEmscripten::readCompositedResults()
+{
+    return readRenderingResultsForPainting();
+}
+
+// The pixels read here are drawn next by Skia, into the page or an image
+// buffer, through its own host context: hand the GL thread back to it.
+static void resumeSkiaContext()
+{
+    if (auto* display = PlatformDisplay::sharedDisplayIfExists()) {
+        if (auto* context = display->skiaGLContext())
+            context->makeContextCurrent();
+    }
+}
+
+RefPtr<NativeImage> GraphicsContextGLEmscripten::copyNativeImageYFlipped(SurfaceBuffer buffer)
+{
+    auto image = GraphicsContextGLANGLE::copyNativeImageYFlipped(buffer);
+    resumeSkiaContext();
+    return image;
+}
+
+GraphicsContextGLANGLE::~GraphicsContextGLANGLE()
+{
+    if (!makeContextCurrent())
+        return;
+    if (m_texture)
+        GL_DeleteTextures(1, &m_texture);
+    if (m_multisampleColorBuffer)
+        GL_DeleteRenderbuffers(1, &m_multisampleColorBuffer);
+    if (m_multisampleDepthStencilBuffer)
+        GL_DeleteRenderbuffers(1, &m_multisampleDepthStencilBuffer);
+    if (m_multisampleFBO)
+        GL_DeleteFramebuffers(1, &m_multisampleFBO);
+    if (m_depthStencilBuffer)
+        GL_DeleteRenderbuffers(1, &m_depthStencilBuffer);
+    if (m_preserveDrawingBufferTexture)
+        GL_DeleteTextures(1, &m_preserveDrawingBufferTexture);
+    if (m_preserveDrawingBufferFBO)
+        GL_DeleteFramebuffers(1, &m_preserveDrawingBufferFBO);
+    if (m_fbo)
+        GL_DeleteFramebuffers(1, &m_fbo);
+}
+
+bool GraphicsContextGLANGLE::makeContextCurrent()
+{
+    auto* context = static_cast<GraphicsContextGLEmscripten*>(this);
+    if (context->isCurrent())
+        return true;
+    if (!context->makeCurrentImpl())
+        return false;
+    context->didMakeContextCurrent();
+    return true;
+}
