+// Multi-draw and base-instance drawing are never offered to pages (their
+// extensions stay unadvertised); these loops only keep the shared code linking
+// and correct if that changes.
+inline void GL_MultiDrawArraysANGLE(GLenum mode, const GLint* firsts, const GLsizei* counts, GLsizei drawcount)
+{
+    for (GLsizei i = 0; i < drawcount; ++i)
+        glDrawArrays(mode, firsts[i], counts[i]);
+}
+inline void GL_MultiDrawArraysInstancedANGLE(GLenum mode, const GLint* firsts, const GLsizei* counts, const GLsizei* instanceCounts, GLsizei drawcount)
+{
+    for (GLsizei i = 0; i < drawcount; ++i)
+        glDrawArraysInstanced(mode, firsts[i], counts[i], instanceCounts[i]);
+}
+inline void GL_MultiDrawElementsANGLE(GLenum mode, const GLsizei* counts, GLenum type, const GLvoid* const* indices, GLsizei drawcount)
+{
+    for (GLsizei i = 0; i < drawcount; ++i)
+        glDrawElements(mode, counts[i], type, indices[i]);
+}
