+// WebGL for pages, drawn by a WebGL context of the host browser. Each page
+// context gets its own host context on an OffscreenCanvas in the engine
+// thread; WebCore's shared WebGL code drives it through the GL entry points in
+// ANGLE/WebGLOverHostWebGL.h. The page's canvas is painted from the drawing
+// buffer's pixels, as for a non-composited canvas.
+class GraphicsContextGLEmscripten final : public GLContextWrapper, public GraphicsContextGLANGLE {
+    WTF_MAKE_TZONE_ALLOCATED(GraphicsContextGLEmscripten);
+public:
+    static RefPtr<GraphicsContextGLEmscripten> create(GraphicsContextGLAttributes&&);
+    virtual ~GraphicsContextGLEmscripten();
+
+    // The context whose GL calls are being made, for the entry points that
+    // depend on its version or extensions.
+    static GraphicsContextGLEmscripten* current();
+
+    RefPtr<GraphicsLayerContentsDisplayDelegate> layerContentsDisplayDelegate() final { return nullptr; }
+#if ENABLE(VIDEO)
+    bool copyTextureFromVideoFrame(VideoFrame&, PlatformGLObject, GCGLenum, GCGLint, GCGLenum, GCGLenum, GCGLenum, bool, bool) final { return false; }
+#endif
+#if ENABLE(MEDIA_STREAM) || ENABLE(WEB_CODECS)
+    RefPtr<VideoFrame> surfaceBufferToVideoFrame(SurfaceBuffer) final { return nullptr; }
+#endif
+    RefPtr<PixelBuffer> readCompositedResults() final;
+    RefPtr<NativeImage> copyNativeImageYFlipped(SurfaceBuffer) final;
+    bool reshapeDrawingBuffer() final;
+    void prepareForDisplay() final;
+
+    bool isWebGL2() const { return m_isForWebGL2; }
+    const char* glString(GCGLenum) const;
+    void requestExtension(const char* glName);
+
+private:
+    friend class GraphicsContextGLANGLE;
+
+    explicit GraphicsContextGLEmscripten(GraphicsContextGLAttributes&&);
+
+    bool platformInitializeContext() final;
+
+    // GLContextWrapper
+    GLContextWrapper::Type type() const final { return GLContextWrapper::Type::Angle; }
+    bool makeCurrentImpl() final;
+    bool unmakeCurrentImpl() final { return true; }
+    unsigned glVersion() const final { return m_isForWebGL2 ? 300 : 200; }
+
+    int m_handle { 0 };
+    CString m_extensions;
+    CString m_requestableExtensions;
+    CString m_renderer;
+    CString m_vendor;
+    // GL extension name, as WebCore asks for it, to the host's WebGL names.
+    HashMap<CString, Vector<CString>> m_webGLNames;
+};
+
+} // namespace WebCore
