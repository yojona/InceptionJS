+EM_JS(void, glEnableiOES, (GLenum target, GLuint index), { GLctx.getExtension('OES_draw_buffers_indexed')?.enableiOES(target, index); });
+EM_JS(void, glDisableiOES, (GLenum target, GLuint index), { GLctx.getExtension('OES_draw_buffers_indexed')?.disableiOES(target, index); });
