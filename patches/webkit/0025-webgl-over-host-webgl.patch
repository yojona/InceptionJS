+
+// Debug output does not exist in WebGL, and WebGL2 always restarts primitives
+// at the fixed index; enabling either is an error there.
+static bool isImplicitCapability(GLenum capability)
+{
+    return capability == GL_DEBUG_OUTPUT_KHR || capability == GL_DEBUG_OUTPUT_SYNCHRONOUS_KHR || capability == GL_PRIMITIVE_RESTART_FIXED_INDEX;
+}
+
+void GL_Enable(GLenum capability)
+{
+    if (!isImplicitCapability(capability))
+        glEnable(capability);
+}
+
+void GL_Disable(GLenum capability)
+{
+    if (!isImplicitCapability(capability))
+        glDisable(capability);
+}
+
+GLboolean GL_IsEnabled(GLenum capability)
+{
+    if (capability == GL_PRIMITIVE_RESTART_FIXED_INDEX) {
+        auto* context = GraphicsContextGLEmscripten::current();
+        return context && context->isWebGL2();
+    }
+    if (isImplicitCapability(capability))
+        return GL_FALSE;
+    return glIsEnabled(capability);
+}
+
+// WebGL 1 names the packed depth and stencil format DEPTH_STENCIL.
+void GL_RenderbufferStorage(GLenum target, GLenum internalformat, GLsizei width, GLsizei height)
+{
+    auto* context = GraphicsContextGLEmscripten::current();
+    if (context && !context->isWebGL2() && internalformat == GL_DEPTH24_STENCIL8_OES)
+        internalformat = GL_DEPTH_STENCIL_OES;
+    glRenderbufferStorage(target, internalformat, width, height);
+}
