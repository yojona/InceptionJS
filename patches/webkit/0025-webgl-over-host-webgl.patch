+// What WebGL itself guarantees, which the shared code checks as extensions:
+// combined depth and stencil, and on WebGL2 multisampled renderbuffers,
+// framebuffer blits, sized color formats and occlusion queries.
+static constexpr std::array alwaysOnWebGL1 { "GL_OES_packed_depth_stencil"_s };
+static constexpr std::array alwaysOnWebGL2 {
+    "GL_OES_packed_depth_stencil"_s, "GL_OES_depth24"_s, "GL_OES_rgb8_rgba8"_s,
+    "GL_ANGLE_framebuffer_blit"_s, "GL_ANGLE_framebuffer_multisample"_s, "GL_EXT_occlusion_query_boolean"_s,
