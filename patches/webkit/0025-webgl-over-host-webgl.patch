+
+RefPtr<GraphicsContextGL> createWebProcessGraphicsContextGL(const GraphicsContextGLAttributes& attributes)
+{
+    return GraphicsContextGLEmscripten::create(GraphicsContextGLAttributes { attributes });
+}
+
+RefPtr<GraphicsContextGLEmscripten> GraphicsContextGLEmscripten::create(GraphicsContextGLAttributes&& attributes)
+{
+    auto context = adoptRef(*new GraphicsContextGLEmscripten(WTF::move(attributes)));
+    if (!context->initialize())
+        return nullptr;
+    return context;
+}
+
+GraphicsContextGLEmscripten::GraphicsContextGLEmscripten(GraphicsContextGLAttributes&& attributes)
+    : GraphicsContextGLANGLE(WTF::move(attributes))
+{
+}
+
+GraphicsContextGLEmscripten* GraphicsContextGLEmscripten::current()
+{
+    return s_current;
+}
+
+GraphicsContextGLEmscripten::~GraphicsContextGLEmscripten()
+{
+    if (!m_handle)
+        return;
+    // The objects die with the host context; only the context itself needs
+    // releasing. The base destructor then finds no context to make current.
+    if (s_current == this)
+        s_current = nullptr;
+    if (isCurrent())
+        didUnmakeContextCurrent();
+    emscripten_webgl_destroy_context(m_handle);
+    m_handle = 0;
+}
+
+bool GraphicsContextGLEmscripten::platformInitializeContext()
+{
+    m_isForWebGL2 = contextAttributes().isWebGL2;
+    m_handle = inception_webgl_create_guest_context(m_isForWebGL2 ? 2 : 1);
+    if (!m_handle || !makeContextCurrent())
+        return false;
+    // The shared code keeps a set of the displays it used; there is no EGL
+    // display here, so all contexts share one stand-in.
+    static int display;
+    m_displayObj = &display;
+
+    HashSet<String> supported;
+    if (char* list = emscripten_webgl_get_supported_extensions()) {
+        for (auto name : StringView::fromLatin1(list).split(' '))
+            supported.add(name.toString());
+        free(list);
+    }
+
+    StringBuilder always;
+    for (auto name : m_isForWebGL2 ? std::span<const ASCIILiteral>(alwaysOnWebGL2) : std::span<const ASCIILiteral>(alwaysOnWebGL1)) {
+        if (!always.isEmpty())
+            always.append(' ');
+        always.append(name);
+    }
+    m_extensions = always.toString().utf8();
+
+    StringBuilder requestable;
+    WebGLVersions version = m_isForWebGL2 ? WebGL2 : WebGL1;
+    for (auto& name : extensionNames) {
+        if (!(name.versions & version) || !supported.contains(String { name.webGL }))
+            continue;
+        auto glName = CString { name.gl.span() };
+        auto& webGLNames = m_webGLNames.ensure(glName, [] { return Vector<CString> { }; }).iterator->value;
+        if (webGLNames.isEmpty()) {
+            if (!requestable.isEmpty())
+                requestable.append(' ');
+            requestable.append(name.gl);
+        }
+        webGLNames.append(CString { name.webGL.span() });
+    }
+    m_requestableExtensions = requestable.toString().utf8();
+
+    auto unmasked = [](bool renderer) {
+        char* value = inception_webgl_unmasked_string(renderer);
+        CString result { value };
+        free(value);
+        return result;
+    };
+    m_renderer = unmasked(true);
+    m_vendor = unmasked(false);
+    return true;
+}
+
+bool GraphicsContextGLEmscripten::makeCurrentImpl()
+{
+    if (!m_handle || emscripten_webgl_make_context_current(m_handle) != EMSCRIPTEN_RESULT_SUCCESS)
+        return false;
+    s_current = this;
+    return true;
+}
+
+const char* GraphicsContextGLEmscripten::glString(GCGLenum name) const
+{
+    switch (name) {
+    case GL_EXTENSIONS:
+        return m_extensions.data();
+    case GL_REQUESTABLE_EXTENSIONS_ANGLE:
+        return m_requestableExtensions.data();
+    case GL_RENDERER:
+        return m_renderer.data();
+    case GL_VENDOR:
+        return m_vendor.data();
+    default:
+        return reinterpret_cast<const char*>(glGetString(name));
+    }
+}
+
+void GraphicsContextGLEmscripten::requestExtension(const char* glName)
+{
+    auto it = m_webGLNames.find(CString { glName });
+    if (it == m_webGLNames.end())
+        return;
+    for (auto& webGLName : it->value)
+        emscripten_webgl_enable_extension(m_handle, webGLName.data());
+}
