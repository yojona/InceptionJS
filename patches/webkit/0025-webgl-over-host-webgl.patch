+void GL_RenderbufferStorageMultisampleANGLE(GLenum target, GLsizei samples, GLenum internalformat, GLsizei width, GLsizei height)
+{
+    glRenderbufferStorageMultisample(target, samples, internalformat, width, height);
+}
+
+// Only reads are mapped (getBufferSubData): the bytes are copied out of the
+// host buffer and freed on unmap.
+static HashMap<GLenum, void*>& mappedBuffers()
+{
+    static NeverDestroyed<HashMap<GLenum, void*>> buffers;
+    return buffers;
+}
+
+void* GL_MapBufferRange(GLenum target, GLintptr offset, GLsizeiptr length, GLbitfield access)
+{
+    if (!(access & GL_MAP_READ_BIT) || (access & GL_MAP_WRITE_BIT) || length <= 0)
+        return nullptr;
+    void* data = malloc(length);
+    if (!data)
+        return nullptr;
+    glGetBufferSubData(target, offset, length, data);
+    if (auto previous = mappedBuffers().take(target))
+        free(previous);
+    mappedBuffers().set(target, data);
+    return data;
+}
+
+GLboolean GL_UnmapBuffer(GLenum target)
+{
+    auto data = mappedBuffers().take(target);
+    if (!data)
+        return GL_FALSE;
+    free(data);
+    return GL_TRUE;
+}
