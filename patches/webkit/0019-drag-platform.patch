+// Drags stay inside the engine's page: there is no system drag session, so a
+// drag-and-drop pasteboard is an ordinary one, without a drag image, and no
+// files arrive from outside.
+
+std::unique_ptr<Pasteboard> Pasteboard::createForDragAndDrop(std::unique_ptr<PasteboardContext>&& context)
+{
+    return makeUnique<Pasteboard>(WTF::move(context));
+}
