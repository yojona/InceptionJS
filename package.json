{
  "name": "inceptionjs-workspace",
  "private": true,
  "description": "InceptionJS: a web browser engine that runs inside a web page. Workspace root, not published.",
  "license": "Apache-2.0",
  "author": "The InceptionJS Authors",
  "homepage": "https://inceptionjs.com",
  "bugs": {
    "url": "https://github.com/yojona/InceptionJS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yojona/InceptionJS.git"
  },
  "type": "module",
  "scripts": {
    "serve": "node tests/serve.mjs",
    "test": "playwright test -c tests/playwright.config.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "perf": "node tests/perf/run.mjs",
    "build:packages": "npm run build -w inceptionjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  },
  "dependencies": {
    "binaryen": "132.0.0"
  },
  "workspaces": [
    "packages/*",
    "examples/react-vite"
  ]
}
